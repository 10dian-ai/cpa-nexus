+func TestNexusPluginSourceIsolatedAndCallerCookieUnavailable(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-synthetic-policy-key-only")
+	var calls int
+	var providerCookieAvailable bool
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Header.Get("User-Agent") != "opencode" {
+			t.Errorf("actual SDK upstream user agent = %q", r.Header.Get("User-Agent"))
+		}
+		if r.Header.Get("X-Device-Id") != "" || r.Header.Get("X-Stainless-Os") != "" {
+			t.Error("original device/SDK data was forwarded")
+		}
+		if r.Header.Get("Cookie") == "private-visitor" {
+			t.Error("visitor cookie leaked")
+		}
+		providerCookieAvailable = r.Header.Get("Cookie") == "provider_session=synthetic-vendor-auth" && r.Header.Get("X-Client-Key") == "synthetic-source-api-key"
+		if !providerCookieAvailable {
+			w.WriteHeader(401)
+			return
+		}
+		w.WriteHeader(200)
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	defer upstream.Close()
+	executor := &fakeExecutor{identifier: "cookie-provider", execute: func(ctx context.Context, req pluginapi.ExecutorRequest) (pluginapi.ExecutorResponse, error) {
+		ginCtx, _ := ctx.Value("gin").(*gin.Context)
+		if ginCtx == nil || ginCtx.Request.Header.Get("Cookie") != "" {
+			t.Error("caller cookie was not structurally removed before plugin invocation")
+		}
+		response, err := req.HTTPClient.Do(ctx, pluginapi.HTTPRequest{Method: "POST", URL: upstream.URL, Headers: http.Header{"User-Agent": {"Private-Caller-CLI"}, "X-Device-Id": {"private-device"}, "X-Stainless-Os": {"private-os"}, "Cookie": {"provider_session=synthetic-vendor-auth"}, "X-Client-Key": {"synthetic-source-api-key"}}, Body: []byte(`{"model":"local-only"}`)})
+		return pluginapi.ExecutorResponse{Payload: response.Body}, err
+	}}
+	host := newRouteModelHostWithRecords(capabilityRecord{id: "vendor-cookie", plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{Executor: executor}}})
+	ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ginCtx.Request = httptest.NewRequest("POST", "/v1/chat/completions", nil)
+	ctx := context.WithValue(context.Background(), "gin", ginCtx)
+	ctx = coreauth.WithNexusGroupPolicy(ctx, coreauth.NewNexusGroupPolicy("local-key", time.Now().Add(time.Second).UnixMilli(), nil, []string{"vendor-cookie"}))
+	_, err := host.ExecutePluginExecutor(ctx, "vendor-cookie", coreexecutor.Request{Model: "local-only"}, coreexecutor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	denied := coreauth.WithNexusGroupPolicy(ctx, coreauth.NewNexusGroupPolicy("other-key", time.Now().Add(time.Second).UnixMilli(), nil, []string{"other-source"}))
+	_, err = host.ExecutePluginExecutor(denied, "vendor-cookie", coreexecutor.Request{Model: "local-only"}, coreexecutor.Options{})
+	if err == nil {
+		t.Fatal("plugin outside group was executed")
+	}
+	if calls != 1 {
+		t.Fatalf("SDK supplier requests = %d, want 1 permitted source only", calls)
+	}
+	if !providerCookieAvailable {
+		t.Fatal("allowed plugin source lost its own vendor authentication cookie")
+	}
+}
+
+func TestNexusHostModelCallbacksRetainImmutablePolicy(t *testing.T) {
+	policy := coreauth.NewNexusGroupPolicy("local-key", 1, []string{"allowed-auth"}, []string{"router"})
+	ctx := coreauth.WithNexusGroupPolicy(context.Background(), policy)
