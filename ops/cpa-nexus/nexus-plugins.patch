+}
+func TestNexusDynamicCallbackMissingStaleAndNativeBackground(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-test-key")
+	host := New()
+	instance := &hostCallbackInstance{}
