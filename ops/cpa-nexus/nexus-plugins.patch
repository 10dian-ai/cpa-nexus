diff --git a/sdk/cliproxy/auth/nexus_group_policy.go b/sdk/cliproxy/auth/nexus_group_policy.go
new file mode 100644
--- /dev/null
+++ b/sdk/cliproxy/auth/nexus_group_policy.go
@@ -0,0 +1,187 @@
+package auth
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"os"
+	"strings"
+)
+
+// NexusGroupPolicy is a request-scoped authorization boundary. Plugins can change models
+// and retry them, but cannot widen this immutable credential/plugin set through metadata.
+type NexusGroupPolicy struct {
+	KeyID     string
+	ExpiresAt int64
+	authIDs   map[string]struct{}
+	pluginIDs map[string]struct{}
+}
+type nexusGroupPolicyContextKey struct{}
+type nexusModelInvocationContextKey struct{}
+type nexusAuthorizedPluginSourceContextKey struct{}
+
+// Only core executor dispatch creates this provenance marker after immutable policy checks.
+func WithNexusAuthorizedPluginSource(ctx context.Context, pluginID, authID string) context.Context {
+	policy := NexusGroupPolicyFromContext(ctx)
+	allowed := policy != nil && ((authID != "" && policy.AllowsAuthID(authID)) || (authID == "" && policy.AllowsPluginID(pluginID)))
+	if policy == nil {
+		// Source dispatch has already selected an actual executor. Independent native
+		// background invocations have no HTTP visitor identity and retain original source
+		// authentication. HTTP requests still require the original authenticated principal.
+		if ctx.Value("gin") == nil && (pluginID != "" || authID != "") {
+			allowed = true
+		}
+		// This value is set only by the original access middleware after Authenticate
+		// succeeds with a nonempty principal. No anonymous or management request is added.
+		if caller, ok := ctx.Value("gin").(*gin.Context); ok && caller != nil {
+			if principal, exists := caller.Get("userApiKey"); exists {
+				if value, valid := principal.(string); valid && strings.TrimSpace(value) != "" {
+					allowed = true
+				}
+			}
+		}
+	}
+	return context.WithValue(ctx, nexusAuthorizedPluginSourceContextKey{}, allowed)
+}
+func nexusVendorCookieAllowed(ctx context.Context) bool {
+	allowed, _ := ctx.Value(nexusAuthorizedPluginSourceContextKey{}).(bool)
+	if !allowed {
+		return false
+	}
+	ginCtx, _ := ctx.Value("gin").(*gin.Context)
+	// Root/Nexus removes visitor cookies structurally before the core. Absence is checked
+	// again here; unknown or cookie-bearing caller provenance never permits cookie forwarding.
+	return ctx.Value("gin") == nil || (ginCtx != nil && ginCtx.Request != nil && ginCtx.Request.Header.Get("Cookie") == "")
+}
+
+func NewNexusGroupPolicy(keyID string, expiresAt int64, authIDs, pluginIDs []string) *NexusGroupPolicy {
+	p := &NexusGroupPolicy{KeyID: keyID, ExpiresAt: expiresAt, authIDs: make(map[string]struct{}), pluginIDs: make(map[string]struct{})}
+	for _, id := range authIDs {
+		if id = strings.TrimSpace(id); id != "" {
+			p.authIDs[id] = struct{}{}
+		}
+	}
+	for _, id := range pluginIDs {
+		if id = strings.TrimSpace(id); id != "" {
+			p.pluginIDs[id] = struct{}{}
+		}
+	}
+	return p
+}
+func WithNexusGroupPolicy(ctx context.Context, policy *NexusGroupPolicy) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, nexusGroupPolicyContextKey{}, policy)
+}
+func NexusGroupPolicyFromContext(ctx context.Context) *NexusGroupPolicy {
+	if ctx == nil {
+		return nil
+	}
+	p, _ := ctx.Value(nexusGroupPolicyContextKey{}).(*NexusGroupPolicy)
+	return p
+}
+func (p *NexusGroupPolicy) AllowsAuthID(id string) bool {
+	if p == nil {
+		return true
+	}
+	_, allowed := p.authIDs[strings.TrimSpace(id)]
+	return allowed
+}
+func (p *NexusGroupPolicy) AllowsPluginID(id string) bool {
+	if p == nil {
+		return true
+	}
+	_, allowed := p.pluginIDs[strings.TrimSpace(id)]
+	return allowed
+}
+func WithNexusModelInvocation(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, nexusModelInvocationContextKey{}, true)
+}
+func WithoutNexusModelNetworkPrivacy(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, nexusModelInvocationContextKey{}, false)
+}
+func IsNexusModelInvocation(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	modelCall, _ := ctx.Value(nexusModelInvocationContextKey{}).(bool)
+	return modelCall
+}
+func nexusPrivateNetworkHeader(name string) bool {
+	switch name {
+	case "origin", "referer", "forwarded", "x-real-ip", "traceparent", "tracestate", "baggage", "x-request-id", "client-request-id", "x-client-request-id", "x-agent-id", "x-subagent-id", "x-app", "anthropic-dangerous-direct-browser-access", "x-project-id", "x-workspace-id", "x-originator", "x-openai-originator", "x-requested-with", "sec-ch-ua", "sec-ch-ua-platform", "sec-ch-ua-mobile", "cf-connecting-ip", "true-client-ip", "x-original-forwarded-for", "x-envoy-external-address", "sentry-trace", "version", "session_id", "session-id", "x-session-id":
+		return true
+	}
+	for _, prefix := range []string{"x-stainless-", "x-claude-code-", "x-claude-remote-", "x-opencode-", "x-client-", "x-device-", "x-openai-client-", "x-sentry-", "x-datadog-", "x-sdk-", "x-nexus-", "x-forwarded-"} {
+		if strings.HasPrefix(name, prefix) {
+			return true
+		}
+	}
+	return strings.HasPrefix(name, "x-codex-") && name != "x-codex-turn-state"
+}
+func ApplyNexusPluginNetworkPrivacy(ctx context.Context, headers http.Header) {
+	if ctx == nil || headers == nil || strings.TrimSpace(os.Getenv("NEXUS_GROUP_POLICY_KEY")) == "" {
+		return
+	}
+	modelCall, _ := ctx.Value(nexusModelInvocationContextKey{}).(bool)
+	if !modelCall {
+		return
+	}
+	allowVendorCookie := nexusVendorCookieAllowed(ctx)
+	googleClientHeader := false
+	session := ""
+	for _, name := range []string{"X-Session-Id", "Session_id", "Session-Id", "X-Claude-Code-Session-Id", "X-Codex-Session-Id"} {
+		if value := strings.TrimSpace(headers.Get(name)); value != "" {
+			session = value
+			break
+		}
+	}
+	for name := range headers {
+		lower := strings.ToLower(name)
+		if lower == "x-goog-api-client" {
+			googleClientHeader = true
+		}
+		if lower == "user-agent" || lower == "originator" || lower == "x-goog-api-client" || (lower == "cookie" && !allowVendorCookie) {
+			delete(headers, name)
+			continue
+		}
+		if lower == "x-app" && strings.EqualFold(strings.TrimSpace(headers.Get(name)), "cli") {
+			continue
+		}
+		// Source authentication exceptions require the same proven selected-source marker
+		// as vendor Cookie. If the caller supplied this name, it is discarded regardless
+		// of value; no generic x-client-* exception exists.
+		if allowVendorCookie {
+			switch lower {
+			case "x-client-key", "x-client-secret":
+				caller, _ := ctx.Value("gin").(*gin.Context)
+				if ctx.Value("gin") == nil || (caller != nil && caller.Request != nil && caller.Request.Header.Get(name) == "") {
+					continue
+				}
+			}
+		}
+		if nexusPrivateNetworkHeader(lower) {
+			delete(headers, name)
+		}
+	}
+	headers.Set("User-Agent", "opencode")
+	headers.Set("Originator", "opencode")
+	if googleClientHeader {
+		headers.Set("X-Goog-Api-Client", "opencode")
+	}
+	if session != "" {
+		mac := hmac.New(sha256.New, []byte(os.Getenv("NEXUS_GROUP_POLICY_KEY")))
+		mac.Write([]byte("cpa-nexus:private-session:v1\x00" + session))
+		headers.Set("X-Session-Id", "session-"+hex.EncodeToString(mac.Sum(nil)))
+	}
+}
