+package auth
+
+import (
+	"context"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestNexusGroupEligibilityIsNotOverriddenByRequestMetadata(t *testing.T) {
+	input := []string{"allowed"}
+	policy := NewNexusGroupPolicy("key", 1, input, []string{"plugin-source"})
+	input[0] = "foreign"
+	ctx := WithNexusGroupPolicy(context.Background(), policy)
+	eligibility := authSelectionEligibilityForRequest(ctx, executor.Options{Metadata: map[string]any{"allowedAuthIDs": []string{"foreign"}}})
+	if !eligibility.allows(&Auth{ID: "allowed"}) || eligibility.allows(&Auth{ID: "foreign"}) {
+		t.Fatal("mutable input/metadata widened the source policy")
+	}
+	child := context.WithoutCancel(ctx)
+	if NexusGroupPolicyFromContext(child) != policy {
+		t.Fatal("stream detachment discarded authorization policy")
+	}
+	if !policy.AllowsPluginID("plugin-source") || policy.AllowsPluginID("other-plugin") {
+		t.Fatal("plugin policy is not isolated")
+	}
+}
+func TestNexusModelPrivacyDoesNotModifyOAuthNetwork(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-test-policy-secret")
+	ctx := WithNexusModelInvocation(context.Background())
+	headers := http.Header{"User-Agent": {"Private-CLI"}, "Authorization": {"Bearer synthetic-upstream"}, "Anthropic-Beta": {"oauth-required-protocol"}, "X-Device-Id": {"private-device"}}
+	ApplyNexusPluginNetworkPrivacy(ctx, headers)
+	if headers.Get("User-Agent") != "opencode" || headers.Get("X-Device-Id") != "" {
+		t.Fatal("SDK software privacy did not apply")
+	}
+	if headers.Get("Authorization") != "Bearer synthetic-upstream" || headers.Get("Anthropic-Beta") != "oauth-required-protocol" {
+		t.Fatal("required authentication/protocol headers were changed")
+	}
+	oauth := http.Header{"User-Agent": {"required-login-agent"}}
+	ApplyNexusPluginNetworkPrivacy(WithoutNexusModelNetworkPrivacy(ctx), oauth)
+	if oauth.Get("User-Agent") != "required-login-agent" {
+		t.Fatal("OAuth network headers were changed")
+	}
+}
+func TestNexusSDKPrivacyDropsCallerIdentitiesAndKeepsVendorProtocol(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-test-policy-secret")
+	headers := http.Header{"user-agent": {"PrivateCLI"}, "x-opencode-device": {"device"}, "x-openai-client-info": {"client"}, "x-client-version": {"version"}, "x-codex-window-id": {"window"}, "x-claude-code-agent-id": {"actor"}, "Traceparent": {"trace"}, "Baggage": {"bag"}, "Cf-Connecting-Ip": {"private-ip"}, "sentry-trace": {"trace"}, "X-Codex-Turn-State": {"protocol-state"}, "X-App": {"cli"}, "Authorization": {"Bearer synthetic-vendor"}, "Anthropic-Beta": {"oauth-protocol-beta"}}
+	ApplyNexusPluginNetworkPrivacy(WithNexusModelInvocation(context.Background()), headers)
+	if headers.Get("User-Agent") != "opencode" {
+		t.Fatal("SDK agent not normalized")
+	}
+	for key := range headers {
+		lower := strings.ToLower(key)
+		if nexusPrivateNetworkHeader(lower) && lower != "x-app" {
+			t.Fatalf("caller identity remained: %s", key)
+		}
+	}
+	if headers.Get("Authorization") != "Bearer synthetic-vendor" || headers.Get("X-App") != "cli" || headers.Get("X-Codex-Turn-State") != "protocol-state" || headers.Get("Anthropic-Beta") != "oauth-protocol-beta" {
+		t.Fatal("vendor authentication or required protocol state changed")
+	}
+}
+
+func TestNexusSchedulerCannotReturnForeignAuthOrDelegateOutsideGroup(t *testing.T) {
+	for _, response := range []pluginapi.SchedulerPickResponse{
+		{Handled: true, AuthID: "source-foreign"},
+		{Handled: true, DelegateBuiltin: pluginapi.SchedulerBuiltinFillFirst},
+		{Handled: true, DelegateBuiltin: pluginapi.SchedulerBuiltinRoundRobin},
