--- /dev/null
+++ b/internal/api/nexus_group_policy_test.go
@@ -0,0 +1,210 @@
+package api
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	sdkaccess "github.com/router-for-me/CLIProxyAPI/v8/sdk/access"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type nexusTestAccessProvider struct{}
+
+func (nexusTestAccessProvider) Identifier() string { return "local-native-access" }
+func (nexusTestAccessProvider) Authenticate(_ context.Context, r *http.Request) (*sdkaccess.Result, *sdkaccess.AuthError) {
+	if r.Header.Get("Authorization") != "Bearer synthetic-native-key" {
+		return nil, sdkaccess.NewInvalidCredentialError()
+	}
+	return &sdkaccess.Result{Provider: "local-native-access", Principal: "synthetic-native-key"}, nil
+}
+func TestNexusNativeAuthenticatedSourceCookiePreservedAndVisitorDiscarded(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "synthetic-source-policy-secret")
+	calls := 0
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Header.Get("Cookie") != "vendor_auth=synthetic-configured-source" {
+			t.Error("selected source's required authentication was lost")
+		}
+		if r.Header.Get("User-Agent") != "opencode" {
+			t.Error("SDK software privacy was lost")
+		}
+		_, _ = w.Write([]byte(`{}`))
+	}))
+	defer provider.Close()
+	access := sdkaccess.NewManager()
+	access.SetProviders([]sdkaccess.Provider{nexusTestAccessProvider{}})
+	engine := gin.New()
+	server := &Server{engine: engine}
+	engine.Use(server.nexusGroupPolicyMiddleware(), AuthMiddleware(access))
+	engine.POST("/v1/local-model", func(c *gin.Context) {
+		if c.Request.Header.Get("Cookie") != "" {
+			t.Error("visitor cookie was visible to source execution")
+		}
+		ctx := context.WithValue(c.Request.Context(), "gin", c)
+		ctx = coreauth.WithNexusAuthorizedPluginSource(ctx, "selected-native-plugin", "")
+		req, _ := http.NewRequestWithContext(ctx, "POST", provider.URL, strings.NewReader(`{}`))
+		req.Header.Set("Cookie", "vendor_auth=synthetic-configured-source")
+		req.Header.Set("User-Agent", "private-original-client")
+		coreauth.ApplyNexusPluginNetworkPrivacy(ctx, req.Header)
+		response, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.Copy(io.Discard, response.Body)
+		_ = response.Body.Close()
+		c.Status(200)
+	})
+	for _, key := range []string{"synthetic-native-key", "invalid-key", ""} {
+		request := httptest.NewRequest("POST", "/v1/local-model", strings.NewReader(`{}`))
+		request.Header.Set("Cookie", "private-visitor")
+		if key != "" {
+			request.Header.Set("Authorization", "Bearer "+key)
+		}
+		response := httptest.NewRecorder()
+		engine.ServeHTTP(response, request)
+		if key == "synthetic-native-key" && response.Code != 200 {
+			t.Fatalf("original authenticated native source status = %d", response.Code)
+		}
+		if key != "synthetic-native-key" && response.Code != 401 {
+			t.Fatalf("unauthorized source status = %d", response.Code)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("supplier calls = %d, want one authenticated source only", calls)
+	}
+}
+func TestNexusOpaquePolicyHeaderMacAndExpiry(t *testing.T) {
+	secret := "local-policy-key-only"
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", secret)
+	server := newTestServer(t)
+	server.engine.GET("/nexus-policy-test", func(c *gin.Context) {
+		policy := coreauth.NexusGroupPolicyFromContext(c.Request.Context())
+		if policy == nil || !policy.AllowsAuthID("source-A") || policy.AllowsAuthID("source-B") {
+			t.Error("opaque policy did not bind exact source set")
+		}
+		c.Status(200)
+	})
+	expires := time.Now().Add(10 * time.Second).UnixMilli()
+	body, _ := json.Marshal(map[string]any{"keyId": "model-key", "expiresAt": expires, "allowedAuthIDs": []string{"source-A"}, "allowedPluginIDs": []string{}})
+	create := httptest.NewRequest("POST", "/v8/management/nexus/group-policies", strings.NewReader(string(body)))
+	create.Header.Set("Authorization", "Bearer test-management-key")
+	create.Header.Set("Content-Type", "application/json")
+	t.Setenv("MANAGEMENT_PASSWORD", "test-management-key")
+	// NewServer captures management environment at construction, so invoke protected handler
+	// directly here; management routing itself is covered by existing version-contract tests.
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	ctx.Request = create
+	server.putNexusGroupPolicy(ctx)
+	if recorder.Code != 200 {
+		t.Fatalf("policy registration status %d", recorder.Code)
+	}
+	var result struct {
+		ID        string `json:"id"`
+		ExpiresAt int64  `json:"expiresAt"`
+	}
+	_ = json.Unmarshal(recorder.Body.Bytes(), &result)
+	message := result.ID + "." + strconv.FormatInt(result.ExpiresAt, 10)
+	mac := hmac.New(sha256.New, []byte(secret))
+	mac.Write([]byte(message))
+	for _, signature := range []string{hex.EncodeToString(mac.Sum(nil)), strings.Repeat("0", 64)} {
+		request := httptest.NewRequest("GET", "/nexus-policy-test", nil)
+		request.Header.Set("X-Nexus-Group-Policy", message+"."+signature)
+		response := httptest.NewRecorder()
+		server.engine.ServeHTTP(response, request)
+		if signature == strings.Repeat("0", 64) && response.Code != 403 {
+			t.Fatalf("forged policy status %d", response.Code)
+		}
+		if signature != strings.Repeat("0", 64) && response.Code != 200 {
+			t.Fatalf("signed policy status %d", response.Code)
+		}
+	}
+}
+
+func TestNexusPolicyConcurrentRegistrationSweepsOnceAndRejectsExpired(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-synthetic-policy-concurrency")
+	server := &Server{}
+	expired := coreauth.NewNexusGroupPolicy("expired-key", time.Now().Add(-time.Second).UnixMilli(), []string{"source"}, nil)
+	server.nexusPolicies.Store("expired", expired)
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			body, _ := json.Marshal(map[string]any{"keyId": "key", "expiresAt": time.Now().Add(10 * time.Second).UnixMilli(), "allowedAuthIDs": []string{"source"}})
+			rec := httptest.NewRecorder()
+			ctx, _ := gin.CreateTestContext(rec)
+			ctx.Request = httptest.NewRequest("POST", "/v8/management/nexus/group-policies", strings.NewReader(string(body)))
+			ctx.Request.Header.Set("Content-Type", "application/json")
+			server.putNexusGroupPolicy(ctx)
+			if rec.Code != 200 {
+				t.Errorf("concurrent registration status=%d", rec.Code)
+			}
+		}()
+	}
+	wg.Wait()
+	count := 0
+	server.nexusPolicies.Range(func(_, _ any) bool { count++; return true })
+	if count != 32 {
+		t.Fatalf("active policy count=%d, want32", count)
+	}
+	if _, exists := server.nexusPolicies.Load("expired"); exists {
+		t.Fatal("expired policy was not collected")
+	}
+	sweepAt := server.nexusPolicySweepAt.Load()
+	if sweepAt == 0 {
+		t.Fatal("collection timestamp missing")
+	}
+	engine := gin.New()
+	engine.Use(server.nexusGroupPolicyMiddleware())
+	engine.GET("/v1/test", func(c *gin.Context) { c.Status(200) })
+	message := "expired." + strconv.FormatInt(expired.ExpiresAt, 10)
+	mac := hmac.New(sha256.New, []byte("local-synthetic-policy-concurrency"))
+	mac.Write([]byte(message))
+	request := httptest.NewRequest("GET", "/v1/test", nil)
+	request.Header.Set("X-Nexus-Group-Policy", message+"."+hex.EncodeToString(mac.Sum(nil)))
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+	if response.Code != 403 {
+		t.Fatalf("expired policy status=%d", response.Code)
+	}
+}
+func TestNexusCapabilitiesClassifiesNativeConfigSourceWithoutBackendAttribute(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-policy-test-key")
+	server := newTestServer(t)
+	manager := server.handlers.AuthManager
+	_, err := manager.Register(context.Background(), &coreauth.Auth{ID: "config-native-account", Provider: "claude", Attributes: map[string]string{"source": "config:claude-api-key:0"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	ctx.Request = httptest.NewRequest("GET", "/v8/management/nexus/capabilities", nil)
+	server.getNexusCapabilities(ctx)
+	var result struct {
+		Accounts []struct{ ID, Source string } `json:"runtimeAccounts"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	for _, account := range result.Accounts {
+		if account.ID == "config-native-account" {
+			if account.Source != "config" {
+				t.Fatalf("native config misclassified as %q", account.Source)
+			}
+			return
+		}
+	}
+	t.Fatal("config runtime account missing")
+}
