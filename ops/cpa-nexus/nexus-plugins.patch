+			if _, err := manager.Register(context.Background(), &Auth{ID: id, Provider: "gemini"}); err != nil {
+				t.Fatal(err)
+			}
+		}
+		manager.SetPluginScheduler(&fakePluginScheduler{resp: response, handled: true})
+		ctx := WithNexusGroupPolicy(context.Background(), NewNexusGroupPolicy("key", 1, []string{"source-permitted"}, nil))
+		for range 3 {
+			selected, _, err := manager.pickNext(ctx, "gemini", "", executor.Options{}, nil)
