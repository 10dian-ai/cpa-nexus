+			if selected == nil || selected.ID != "source-permitted" {
+				t.Fatalf("scheduler selected foreign source: %#v", selected)
+			}
+		}
+	}
+}
+func TestNexusSelectedSourceAuthenticationHeaderRequiresCallerAbsence(t *testing.T) {
+	t.Setenv("NEXUS_GROUP_POLICY_KEY", "local-only-header-test-key")
+	for _, hasCallerHeader := range []bool{false, true} {
+		caller, _ := gin.CreateTestContext(httptest.NewRecorder())
+		caller.Request = httptest.NewRequest("POST", "/v1/chat/completions", nil)
+		caller.Set("userApiKey", "synthetic-authenticated-native-principal")
+		if hasCallerHeader {
+			caller.Request.Header.Set("X-Client-Key", "private-caller-value")
+			caller.Request.Header.Set("X-Client-Secret", "private-caller-value")
+		}
+		ctx := WithNexusModelInvocation(context.WithValue(context.Background(), "gin", caller))
+		ctx = WithNexusAuthorizedPluginSource(ctx, "selected-native-source", "")
+		headers := http.Header{"X-Client-Key": {"synthetic-source-vendor-key"}, "X-Client-Secret": {"synthetic-source-vendor-secret"}, "X-Client-Version": {"private-software-version"}}
+		ApplyNexusPluginNetworkPrivacy(ctx, headers)
+		if hasCallerHeader && (headers.Get("X-Client-Key") != "" || headers.Get("X-Client-Secret") != "") {
+			t.Fatal("caller credential header was permitted")
+		}
+		if !hasCallerHeader && (headers.Get("X-Client-Key") != "synthetic-source-vendor-key" || headers.Get("X-Client-Secret") != "synthetic-source-vendor-secret") {
+			t.Fatal("selected authenticated source's vendor key was lost")
+		}
+		if headers.Get("X-Client-Version") != "" {
+			t.Fatal("client identity header was permitted")
+		}
+	}
+}
