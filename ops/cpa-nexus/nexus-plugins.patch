diff --git a/internal/api/nexus_group_policy.go b/internal/api/nexus_group_policy.go
new file mode 100644
--- /dev/null
+++ b/internal/api/nexus_group_policy.go
@@ -0,0 +1,125 @@
+package api
+
+import (
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+func nexusPolicyEnabled() bool { return strings.TrimSpace(os.Getenv("NEXUS_GROUP_POLICY_KEY")) != "" }
+func (s *Server) nexusGroupPolicyMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		ctx := c.Request.Context()
+		if strings.HasPrefix(c.Request.URL.Path, "/v1/") || strings.HasPrefix(c.Request.URL.Path, "/v1beta/") {
+			ctx = coreauth.WithNexusModelInvocation(ctx)
+		}
+		if encoded := c.GetHeader("X-Nexus-Group-Policy"); encoded != "" {
+			parts := strings.Split(encoded, ".")
+			deny := func() {
+				c.AbortWithStatusJSON(http.StatusForbidden, gin.H{"error": gin.H{"code": "nexus_group_policy_invalid", "message": "Invalid or expired group policy"}})
+			}
+			if !nexusPolicyEnabled() || len(parts) != 3 {
+				deny()
+				return
+			}
+			expires, err := strconv.ParseInt(parts[1], 10, 64)
+			if err != nil || expires <= time.Now().UnixMilli() {
+				deny()
+				return
+			}
+			signature, err := hex.DecodeString(parts[2])
+			mac := hmac.New(sha256.New, []byte(os.Getenv("NEXUS_GROUP_POLICY_KEY")))
+			mac.Write([]byte(parts[0] + "." + parts[1]))
+			if err != nil || !hmac.Equal(signature, mac.Sum(nil)) {
+				deny()
+				return
+			}
+			stored, exists := s.nexusPolicies.Load(parts[0])
+			if !exists {
+				deny()
+				return
+			}
+			policy, valid := stored.(*coreauth.NexusGroupPolicy)
+			if !valid || policy.ExpiresAt != expires {
+				deny()
+				return
+			}
+			ctx = coreauth.WithNexusGroupPolicy(ctx, policy)
+		}
+		c.Request = c.Request.WithContext(ctx)
+		c.Next()
+	}
+}
+func (s *Server) putNexusGroupPolicy(c *gin.Context) {
+	if !nexusPolicyEnabled() {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "nexus_group_policy_not_configured"})
+		return
+	}
+	var body struct {
+		KeyID     string   `json:"keyId"`
+		ExpiresAt int64    `json:"expiresAt"`
+		AuthIDs   []string `json:"allowedAuthIDs"`
+		PluginIDs []string `json:"allowedPluginIDs"`
+	}
+	if err := c.ShouldBindJSON(&body); err != nil || body.KeyID == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_group_policy"})
+		return
+	}
+	now := time.Now().UnixMilli()
+	if body.ExpiresAt <= now || body.ExpiresAt > now+30000 {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid_policy_expiry"})
+		return
+	}
+	bytes := make([]byte, 16)
+	if _, err := rand.Read(bytes); err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "policy_creation_failed"})
+		return
+	}
+	id := hex.EncodeToString(bytes)
+	lastSweep := s.nexusPolicySweepAt.Load()
+	if now-lastSweep >= 1000 && s.nexusPolicySweepAt.CompareAndSwap(lastSweep, now) {
+		s.nexusPolicies.Range(func(key, value any) bool {
+			if policy, ok := value.(*coreauth.NexusGroupPolicy); !ok || policy.ExpiresAt <= now {
+				s.nexusPolicies.Delete(key)
+			}
+			return true
+		})
+	}
+	s.nexusPolicies.Store(id, coreauth.NewNexusGroupPolicy(body.KeyID, body.ExpiresAt, body.AuthIDs, body.PluginIDs))
+	c.JSON(http.StatusOK, gin.H{"id": id, "expiresAt": body.ExpiresAt})
+}
+func (s *Server) getNexusCapabilities(c *gin.Context) {
+	plugins := []gin.H{}
+	if s.pluginHost != nil {
+		for _, plugin := range s.pluginHost.RegisteredPlugins() {
+			plugins = append(plugins, gin.H{"id": plugin.ID, "provider": plugin.ExecutorProvider, "executorModelScope": plugin.ExecutorModelScope, "capabilities": plugin.Capabilities,
+				"modelClientIDs": []string{"plugin:" + plugin.ID + ":" + plugin.ExecutorProvider, "plugin:" + plugin.ID + ":" + plugin.ExecutorProvider + ":executor"}})
+		}
+	}
+	accounts := []gin.H{}
+	if s.handlers != nil && s.handlers.AuthManager != nil {
+		for _, account := range s.handlers.AuthManager.List() {
+			if account == nil {
+				continue
+			}
+			account.EnsureIndex()
+			source, path := account.AuthSourceKind(), ""
+			if account.Attributes != nil {
+				path = account.Attributes[coreauth.AttributePath]
+			}
+			if source == "" {
+				source = "memory"
+			}
+			accounts = append(accounts, gin.H{"id": account.ID, "authIndex": account.Index, "fileName": account.FileName, "provider": account.Provider, "source": source, "sourcePath": path, "prefix": account.Prefix, "disabled": account.Disabled})
+		}
+	}
+	c.JSON(http.StatusOK, gin.H{"schemaVersion": 1, "groupPolicy": gin.H{"enabled": nexusPolicyEnabled(), "protocol": "opaque-hmac-sha256-v1"}, "plugins": plugins, "runtimeAccounts": accounts})
+}
