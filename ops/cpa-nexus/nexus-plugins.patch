diff --git a/internal/pluginhost/nexus_capabilities.go b/internal/pluginhost/nexus_capabilities.go
new file mode 100644
--- /dev/null
+++ b/internal/pluginhost/nexus_capabilities.go
@@ -0,0 +1,84 @@
+package pluginhost
+
+import (
+	"context"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/thinking"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	"os"
+	"strings"
+)
+
+func nexusPluginCapabilities(c pluginapi.Capabilities) map[string]bool {
+	return map[string]bool{
+		"modelRegistrar": c.ModelRegistrar != nil, "modelProvider": c.ModelProvider != nil, "authProvider": c.AuthProvider != nil, "frontendAuthProvider": c.FrontendAuthProvider != nil,
+		"scheduler": c.Scheduler != nil, "modelRouter": c.ModelRouter != nil, "executor": c.Executor != nil, "requestTranslator": c.RequestTranslator != nil, "requestNormalizer": c.RequestNormalizer != nil,
+		"requestInterceptor": c.RequestInterceptor != nil, "requestLifecyclePlugin": c.RequestLifecyclePlugin != nil, "responseTranslator": c.ResponseTranslator != nil, "responseBeforeTranslator": c.ResponseBeforeTranslator != nil,
+		"responseAfterTranslator": c.ResponseAfterTranslator != nil, "responseInterceptor": c.ResponseInterceptor != nil, "streamChunkInterceptor": c.StreamChunkInterceptor != nil, "webSocketResponseObserver": c.WebSocketResponseObserver != nil,
+		"thinkingApplier": c.ThinkingApplier != nil, "usagePlugin": c.UsagePlugin != nil, "commandLinePlugin": c.CommandLinePlugin != nil, "managementAPI": c.ManagementAPI != nil, "quotaProvider": c.QuotaProvider != nil,
+	}
+}
+
+func (h *Host) resolveNexusModelCallbackContext(id string, fallback context.Context) (context.Context, error) {
+	if strings.TrimSpace(os.Getenv("NEXUS_GROUP_POLICY_KEY")) == "" {
+		return h.resolveCallbackContext(id, fallback), nil
+	}
+	if id != "" {
+		actual, pluginID, instance, valid := h.lookupCallbackContext(id)
+		if !valid || (instance != nil && instance.closed.Load()) {
+			return nil, fmt.Errorf("model callback context is missing or expired")
+		}
+		if caller := hostCallbackPluginIDFromContext(fallback); caller != "" && caller != pluginID {
+			return nil, fmt.Errorf("model callback context belongs to another plugin")
+		}
+		if caller := hostCallbackInstanceFromContext(fallback); caller != nil && instance != nil && caller != instance {
+			return nil, fmt.Errorf("model callback context belongs to another plugin instance")
+		}
+		return actual, nil
+	}
+	// Direct internal calls retain an existing protected context. Dynamic C ABI callbacks
+	// cannot silently become unrestricted background calls if an older plugin omits its ID.
+	pluginID, instance := hostCallbackPluginIDFromContext(fallback), hostCallbackInstanceFromContext(fallback)
+	if h != nil && h.callbackContexts != nil && (pluginID != "" || instance != nil) {
+		h.callbackContexts.mu.RLock()
+		ambiguous := false
+		for _, entry := range h.callbackContexts.contexts {
+			if (pluginID == "" || entry.pluginID == pluginID) && (instance == nil || entry.instance == instance) && coreauth.NexusGroupPolicyFromContext(entry.ctx) != nil {
+				ambiguous = true
+				break
+			}
+		}
+		h.callbackContexts.mu.RUnlock()
+		if ambiguous {
+			return nil, fmt.Errorf("scoped model callback requires host_callback_id")
+		}
+	}
+	return h.resolveCallbackContext(id, fallback), nil
+}
+
+// Static no-auth executor sources are selected through the host, while provider OAuth
+// sources keep the normal auth manager. Only models actually registered by this plugin count.
+func (h *Host) NexusPluginExecutorForModel(ctx context.Context, model string) string {
+	policy := coreauth.NexusGroupPolicyFromContext(ctx)
+	if h == nil || policy == nil {
+		return ""
+	}
+	base := strings.TrimSpace(thinking.ParseSuffix(model).ModelName)
+	for _, record := range h.activeRecords() {
+		if record.plugin.Capabilities.Executor == nil || !policy.AllowsPluginID(record.id) || h.isPluginFused(record.id) {
+			continue
+		}
+		provider, valid := h.executorProvider(record, record.plugin.Capabilities.Executor)
+		if !valid {
+			continue
+		}
+		for _, item := range registry.GetGlobalRegistry().GetModelsForClient(pluginExecutorModelClientID(record.id, provider)) {
+			if item != nil && (item.ID == model || item.ID == base) {
+				return record.id
+			}
+		}
+	}
+	return ""
+}
