@@ -0,0 +1,20 @@
+package openai
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	"github.com/tidwall/gjson"
+)
+
+func redactResponsesWebsocketError(payload []byte) []byte {
+	event := gjson.GetBytes(payload, "type").String()
+	for _, path := range []string{"error", "response.error"} {
+		value := gjson.GetBytes(payload, path)
+		if value.Exists() && value.Type != gjson.Null && value.Type != gjson.False && value.Raw != "0" && value.Raw != `""` {
+			return logging.RedactPublicErrorBody(payload)
+		}
+	}
+	if event == "error" || event == "response.failed" || gjson.GetBytes(payload, "response.status").String() == "failed" {
+		return logging.RedactPublicErrorBody(payload)
+	}
+	return payload
+}
