diff --git a/internal/api/nexus_log_privacy.go b/internal/api/nexus_log_privacy.go
new file mode 100644
index 0000000000000000000000000000000000000000..ee8d8417216057a47ed8462ceb2b3ce2983173ab
--- /dev/null
+++ b/internal/api/nexus_log_privacy.go
@@ -0,0 +1,108 @@
+package api
+
+import (
+	"bytes"
+	"compress/gzip"
+	"compress/zlib"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/andybalholm/brotli"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+)
+
+// Only failed HTTP responses are buffered. Successful streaming and upgrades
+// retain the original writer, flushing, and hijacking behavior.
+type nexusPublicErrorWriter struct {
+	gin.ResponseWriter
+	body bytes.Buffer
+}
+
+func (w *nexusPublicErrorWriter) WriteHeader(status int) {
+	if !w.Written() {
+		w.ResponseWriter.WriteHeader(status)
+	}
+}
+
+func (w *nexusPublicErrorWriter) Write(body []byte) (int, error) {
+	if w.Status() >= http.StatusBadRequest {
+		return w.body.Write(body)
+	}
+	return w.ResponseWriter.Write(body)
+}
+
+func (w *nexusPublicErrorWriter) WriteString(body string) (int, error) {
+	return w.Write([]byte(body))
+}
+
+func (w *nexusPublicErrorWriter) WriteHeaderNow() {
+	if w.Status() < http.StatusBadRequest {
+		w.ResponseWriter.WriteHeaderNow()
+	}
+}
+
+func (w *nexusPublicErrorWriter) Flush() {
+	if w.Status() < http.StatusBadRequest {
+		w.ResponseWriter.Flush()
+	}
+}
+
+func (w *nexusPublicErrorWriter) Written() bool {
+	return w.body.Len() > 0 || w.ResponseWriter.Written()
+}
+
+func (w *nexusPublicErrorWriter) Size() int {
+	if w.body.Len() > 0 {
+		return w.body.Len()
+	}
+	return w.ResponseWriter.Size()
+}
+
+func nexusDecodeErrorBody(body []byte, encoding string) ([]byte, error) {
+	var reader io.Reader = bytes.NewReader(body)
+	switch strings.ToLower(strings.TrimSpace(encoding)) {
+	case "gzip":
+		decoder, err := gzip.NewReader(reader)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = decoder.Close() }()
+		reader = decoder
+	case "deflate":
+		decoder, err := zlib.NewReader(reader)
+		if err != nil {
+			return nil, err
+		}
+		defer func() { _ = decoder.Close() }()
+		reader = decoder
+	case "br":
+		reader = brotli.NewReader(reader)
+	case "", "identity":
+		return body, nil
+	default:
+		return nil, http.ErrNotSupported
+	}
+	return io.ReadAll(reader)
+}
+
+func nexusPublicErrorMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		writer := &nexusPublicErrorWriter{ResponseWriter: c.Writer}
+		c.Writer = writer
+		c.Next()
+		if writer.Status() < http.StatusBadRequest || writer.ResponseWriter.Written() {
+			return
+		}
+		body, err := nexusDecodeErrorBody(writer.body.Bytes(), writer.Header().Get("Content-Encoding"))
+		if err != nil {
+			body = []byte(`{"error":{"type":"upstream_error","message":"Upstream request failed"}}`)
+			writer.Header().Set("Content-Type", "application/json")
+		}
+		writer.Header().Del("Content-Encoding")
+		writer.Header().Del("Content-Length")
+		writer.Header().Del("ETag")
+		_, _ = writer.ResponseWriter.Write(logging.RedactPublicErrorBody(body))
+	}
+}
