+	}
+}
+
+func TestNexusGlobalLogRedactsStructuredFields(t *testing.T) {
+	entry := &log.Entry{Message: "Provider rejected https://host.test/path", Level: log.ErrorLevel,
+		Data: log.Fields{"provider": "Anthropic", "model": "claude-sonnet", "error": "Gemini quota"}}
+	body, err := (&LogFormatter{}).Format(entry)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if nexusPublicProvider.Match(body) || nexusPublicURL.Match(body) || !bytes.Contains(body, []byte("provider=***")) {
+		t.Fatalf("structured log leaked: %s", body)
+	}
+	logger := &FileRequestLogger{}
+	if filename := logger.generateFilename("/v1beta/models/gemini-pro:streamGenerateContent", "abc12345"); nexusPublicProvider.MatchString(filename) {
+		t.Fatalf("filename leaked: %s", filename)
+	}
+	if filename := logger.generateFilename("/v1/responses", "Gemini12"); nexusPublicProvider.MatchString(filename) || strings.Contains(filename, "*") {
+		t.Fatalf("request ID leaked or produced an invalid filename: %s", filename)
+	}
+}
