+
+func TestNexusPublicRedaction(t *testing.T) {
+	for _, text := range []string{
+		`ChatGPT Gemini Anthropic CLAUDE OpenAI Devin`,
+		`Devin upstream_host=server.codeium.com Windsurf GOAT`,
+		`HTTP://host.test/path?token=private HTTPS://host.test/path`,
+		`https:\/\/host.test\/path?token=private`,
+		`https:\u002f\u002fhost.test\u002fpath?token=private`,
+		`chat-gpt chat_gpt chat gpt open-ai deep_seek Command-Code`,
+		`Google google/model meta-provider glm_model 阿里巴巴 通义千问`,
+	} {
+		filtered := RedactPublicText(text)
+		if strings.Contains(strings.ToLower(filtered), "http") || nexusPublicProvider.MatchString(filtered) {
+			t.Fatalf("sensitive output survived: %q", filtered)
+		}
+		if !strings.Contains(filtered, "***") {
+			t.Fatalf("no replacement in %q", filtered)
+		}
+	}
+	if got := RedactPublicText("metadata metallurgy glamorous crawl AWSOME"); got != "metadata metallurgy glamorous crawl AWSOME" {
+		t.Fatalf("ordinary text was changed: %q", got)
+	}
+}
+
+func TestNexusErrorJSONPreservesEscapingAndClassification(t *testing.T) {
+	body := []byte(`{"error":{"message":"\u0041nthropic rejected https:\/\/host.test\/path\"; Gemini","type":"authentication_error","code":"upstream_authentication_required","retryable":false},"sequence":9007199254740993}`)
+	filtered := RedactPublicErrorBody(body)
+	if !json.Valid(filtered) {
+		t.Fatalf("invalid error JSON: %s", filtered)
+	}
+	var decoded struct {
+		Error struct {
+			Message   string `json:"message"`
+			Type      string `json:"type"`
+			Code      string `json:"code"`
+			Retryable bool   `json:"retryable"`
+		} `json:"error"`
+		Sequence json.Number `json:"sequence"`
+	}
+	if err := json.Unmarshal(filtered, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.Error.Message != `*** rejected ***"; ***` || decoded.Error.Type != "authentication_error" || decoded.Error.Code != "upstream_authentication_required" || decoded.Error.Retryable || decoded.Sequence != "9007199254740993" {
+		t.Fatalf("error classification or escaping changed: %s", filtered)
+	}
+	plain := []byte(" {\"error\":\"ordinary failure\"} \n")
+	if !bytes.Equal(RedactPublicErrorBody(plain), plain) {
+		t.Fatal("unrelated error payload changed")
+	}
+}
+
+func TestNexusFileWriterRedactsAcrossEveryChunkBoundary(t *testing.T) {
+	text := strings.Repeat("x", 137) + " metadata Google/ Gemini Chat GPT 阿里巴巴 https://host.test/" + strings.Repeat("sensitive-", 10000) + " Anthropic \n" + strings.Repeat("z", 300) + " claude-sonnet metadata\n"
+	want := RedactPublicText(text)
+	for _, size := range []int{1, 2, 3, 4, 7, 31, 127, 128, 129, 1024, 32768} {
+		var out bytes.Buffer
+		writer := &publicLogWriter{destination: &out}
+		for start := 0; start < len(text); start += size {
+			end := min(start+size, len(text))
+			if _, err := writer.Write([]byte(text[start:end])); err != nil {
+				t.Fatal(err)
+			}
+			if len(writer.pending) > 128+64 {
+				t.Fatalf("unbounded pending buffer for chunk %d: %d", size, len(writer.pending))
+			}
+		}
+		if err := writer.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		if out.String() != want {
+			t.Fatalf("chunk %d changed the redacted output: %q", size, out.String())
+		}
+	}
+}
+
+func TestNexusFileWriterKeepsJSONEscapeBoundaries(t *testing.T) {
+	text := `{"message":"https://host.test/` + strings.Repeat("private", 10000) + `\" and Gemini"}`
+	for _, size := range []int{1, 2, 127, 1024, 32768} {
+		var out bytes.Buffer
+		writer := &publicLogWriter{destination: &out}
+		for start := 0; start < len(text); start += size {
+			_, _ = writer.Write([]byte(text[start:min(start+size, len(text))]))
+		}
+		if err := writer.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		if !json.Valid(out.Bytes()) || out.String() != RedactPublicText(text) {
+			t.Fatalf("chunk %d broke JSON escapes: %q", size, out.String())
