new file mode 100644
index 0000000000000000000000000000000000000000..9890145f7a416d3468d1b3ec6151e365cb1cc569
--- /dev/null
+++ b/internal/api/nexus_log_privacy_test.go
@@ -0,0 +1,60 @@
+package api
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestNexusNativeHTTPErrorRedaction(t *testing.T) {
+	for _, compressed := range []bool{false, true} {
+		engine := gin.New()
+		engine.Use(nexusPublicErrorMiddleware())
+		engine.GET("/v1beta/test", func(c *gin.Context) {
+			body := []byte(`{"error":{"message":"Anthropic https://host.test/path Gemini","code":"permission_denied"}}`)
+			if compressed {
+				var encoded bytes.Buffer
+				writer := gzip.NewWriter(&encoded)
+				_, _ = writer.Write(body)
+				_ = writer.Close()
+				body = encoded.Bytes()
+				c.Header("Content-Encoding", "gzip")
+			}
+			c.Header("Content-Type", "application/json")
+			c.Header("Content-Length", "9999")
+			c.Status(http.StatusForbidden)
+			for _, b := range body {
+				_, _ = c.Writer.Write([]byte{b})
+				c.Writer.Flush()
+			}
+		})
+		recorder := httptest.NewRecorder()
+		engine.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/v1beta/test", nil))
+		if recorder.Code != http.StatusForbidden || !json.Valid(recorder.Body.Bytes()) || strings.Contains(recorder.Body.String(), "https:") || strings.Contains(recorder.Body.String(), "Anthropic") || !strings.Contains(recorder.Body.String(), "permission_denied") || recorder.Header().Get("Content-Encoding") != "" || recorder.Header().Get("Content-Length") != "" {
+			t.Fatalf("native error leaked or changed: %d %s %s", recorder.Code, recorder.Header(), recorder.Body.String())
+		}
+	}
+}
+
+func TestNexusNativeSuccessfulStreamStaysUnchanged(t *testing.T) {
+	engine := gin.New()
+	engine.Use(nexusPublicErrorMiddleware())
+	text := "data: {\"choices\":[{\"delta\":{\"content\":\"Anthropic https://host.test/path\"}}]}\n\n"
+	engine.GET("/v1/test", func(c *gin.Context) {
+		c.Header("Content-Type", "text/event-stream")
+		c.Status(http.StatusOK)
+		_, _ = c.Writer.WriteString(text)
+		c.Writer.Flush()
+	})
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/v1/test", nil))
+	if recorder.Code != http.StatusOK || recorder.Body.String() != text || !recorder.Flushed {
+		t.Fatalf("successful stream changed: %d %q", recorder.Code, recorder.Body.String())
+	}
+}
