diff --git a/internal/logging/nexus_public_redaction.go b/internal/logging/nexus_public_redaction.go
new file mode 100644
index 0000000000000000000000000000000000000000..4edf865a456ed36deeec207d0b3fc6bb5450d8c3
--- /dev/null
+++ b/internal/logging/nexus_public_redaction.go
@@ -0,0 +1,189 @@
+package logging
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"regexp"
+	"strings"
+	"unicode/utf8"
+)
+
+var nexusPublicURL = regexp.MustCompile("(?i)https?:(?:/|\\\\/|\\\\u002f){2}(?:\\\\/|\\\\u[0-9a-f]{4}|[^\\s<>\"'`\\\\])*")
+var nexusPublicProvider = regexp.MustCompile(`(?i)chat[\s_-]*gpt|open[\s_-]*ai|anthropic|gemini|claude|codex|deep[\s_-]*seek|x[\s_-]*ai|grok|qwen|zhipu|moonshot|kimi|mistral|cohere|perplexity|nvidia|vertex[\s_-]*ai|vertex|microsoft|azure|bedrock|amazon|mini[\s_-]*max|baidu|doubao|byte[\s_-]*dance|tencent|hunyuan|devin|codeium|windsurf|goat|cognition|augment|antigravity|kiro|command[\s_-]*code|谷歌|阿里巴巴|阿里|通义千问|智谱|腾讯|字节跳动|豆包|百度|文心一言|文心|英伟达|微软|亚马逊`)
+var nexusPublicShortProvider = regexp.MustCompile(`(?i)meta|llama|glm|aws|google`)
+
+func nexusASCIIAlphaNumeric(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+}
+
+// RedactPublicText filters only an output copy, never routing or authentication data.
+func RedactPublicText(text string) string {
+	text = nexusPublicURL.ReplaceAllString(text, "***")
+	text = nexusPublicProvider.ReplaceAllString(text, "***")
+	var out strings.Builder
+	last := 0
+	for _, match := range nexusPublicShortProvider.FindAllStringIndex(text, -1) {
+		if match[0] > 0 && nexusASCIIAlphaNumeric(text[match[0]-1]) || match[1] < len(text) && nexusASCIIAlphaNumeric(text[match[1]]) {
+			continue
+		}
+		out.WriteString(text[last:match[0]])
+		out.WriteString("***")
+		last = match[1]
+	}
+	if last == 0 {
+		return text
+	}
+	out.WriteString(text[last:])
+	return out.String()
+}
+
+func nexusRedactJSON(value any, changed *bool) any {
+	switch v := value.(type) {
+	case string:
+		filtered := RedactPublicText(v)
+		*changed = *changed || filtered != v
+		return filtered
+	case []any:
+		for i := range v {
+			v[i] = nexusRedactJSON(v[i], changed)
+		}
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for key, item := range v {
+			filtered := RedactPublicText(key)
+			*changed = *changed || filtered != key
+			out[filtered] = nexusRedactJSON(item, changed)
+		}
+		return out
+	}
+	return value
+}
+
+// RedactPublicErrorBody decodes JSON before filtering so escaping stays valid.
+func RedactPublicErrorBody(body []byte) []byte {
+	if json.Valid(body) {
+		var value any
+		decoder := json.NewDecoder(bytes.NewReader(body))
+		decoder.UseNumber()
+		if decoder.Decode(&value) == nil {
+			changed := false
+			value = nexusRedactJSON(value, &changed)
+			if !changed {
+				return body
+			}
+			if result, err := json.Marshal(value); err == nil {
+				return result
+			}
+		}
+	}
+	return []byte(RedactPublicText(string(body)))
+}
+
+// publicLogWriter keeps bounded lookbehind across file-backed sections and chunks.
+// Long URLs are suppressed incrementally rather than buffered in full.
+type publicLogWriter struct {
+	destination io.Writer
+	pending     []byte
+	inURL       bool
+	previous    byte
+}
+
+func (w *publicLogWriter) emit(text string, next byte) error {
+	if len(text) == 0 {
+		return nil
+	}
+	guard, suffix := "", ""
+	if nexusASCIIAlphaNumeric(w.previous) {
+		guard = "0"
+	}
+	if nexusASCIIAlphaNumeric(next) {
+		suffix = "0"
+	}
+	filtered := RedactPublicText(guard + text + suffix)
+	w.previous = text[len(text)-1]
+	_, err := io.WriteString(w.destination, filtered[len(guard):len(filtered)-len(suffix)])
+	return err
+}
+
+func nexusURLDelimiter(c byte) bool {
+	return c <= ' ' || c == '<' || c == '>' || c == '"' || c == '\'' || c == '`'
+}
+
+func (w *publicLogWriter) drain(final bool) error {
+	if w.inURL {
+		i := 0
+		for i < len(w.pending) && !nexusURLDelimiter(w.pending[i]) {
+			if w.pending[i] == '\\' {
+				if i+1 == len(w.pending) && !final {
+					w.pending = w.pending[i:]
+					return nil
+				}
+				if i+1 < len(w.pending) && (w.pending[i+1] == '"' || w.pending[i+1] == '\'' || w.pending[i+1] == '`') {
+					break
+				}
+			}
+			i++
+		}
+		w.pending = w.pending[i:]
+		if len(w.pending) == 0 {
+			return nil
+		}
+		w.inURL = false
+		w.previous = ' '
+	}
+	cut := len(w.pending)
+	if !final {
+		cut -= 128
+		if cut <= 0 {
+			return nil
+		}
+		for cut > 0 && !utf8.RuneStart(w.pending[cut]) {
+			cut--
+		}
+		for _, pattern := range []*regexp.Regexp{nexusPublicURL, nexusPublicProvider, nexusPublicShortProvider} {
+			for _, match := range pattern.FindAllIndex(w.pending, -1) {
+				if pattern == nexusPublicURL && match[0] < cut && match[1] == len(w.pending) {
+					if err := w.emit(string(w.pending[:match[0]]), w.pending[match[0]]); err != nil {
+						return err
+					}
+					if _, err := io.WriteString(w.destination, "***"); err != nil {
+						return err
+					}
+					w.pending = w.pending[:0]
+					w.inURL = true
+					w.previous = ' '
+					return nil
+				}
+				if match[0] < cut && match[1] > cut {
+					cut = match[0]
+				}
+			}
+		}
+	}
+	var next byte
+	if cut < len(w.pending) {
+		next = w.pending[cut]
+	}
+	if err := w.emit(string(w.pending[:cut]), next); err != nil {
+		return err
+	}
+	w.pending = append(w.pending[:0], w.pending[cut:]...)
+	return nil
+}
+
+func (w *publicLogWriter) Write(body []byte) (int, error) {
+	written := 0
+	for len(body) > 0 {
+		n := min(len(body), 32*1024)
+		w.pending = append(w.pending, body[:n]...)
+		if err := w.drain(false); err != nil {
+			return written, err
+		}
+		body = body[n:]
+		written += n
+	}
+	return written, nil
+}
+
+func (w *publicLogWriter) Flush() error { return w.drain(true) }
