+package openai
+
+import (
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	"github.com/tidwall/gjson"
+)
+
+func TestNexusWebsocketErrorRedaction(t *testing.T) {
+	body, err := buildResponsesWebsocketErrorPayload(&interfaces.ErrorMessage{
+		StatusCode: http.StatusUnauthorized,
+		Error:      errors.New("Anthropic failed at https://host.test/path"),
+		Addon:      http.Header{"Location": {"https://host.test/path"}, "X-Provider": {"Gemini"}, "Retry-After": {"3"}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(body), "Anthropic") || strings.Contains(string(body), "Gemini") || strings.Contains(string(body), "https:") || gjson.GetBytes(body, "status").Int() != 401 || gjson.GetBytes(body, "type").String() != "error" || gjson.GetBytes(body, "headers.Retry-After").String() != "3" {
+		t.Fatalf("websocket error leaked or changed classification: %s", body)
+	}
+}
+
+func TestNexusWebsocketPassthroughOnlyChangesErrors(t *testing.T) {
+	success := []byte(`{"type":"response.created","response":{"error":null,"model":"codex","text":"Anthropic https://host.test/path"}}`)
+	if string(redactResponsesWebsocketError(success)) != string(success) {
+		t.Fatal("normal WebSocket payload changed")
+	}
+	failure := []byte(`{"type":"response.failed","response":{"error":{"message":"Gemini https://host.test/path"}}}`)
+	filtered := string(redactResponsesWebsocketError(failure))
+	if strings.Contains(filtered, "Gemini") || strings.Contains(filtered, "https:") || !strings.Contains(filtered, "response.failed") {
+		t.Fatalf("raw WebSocket failure leaked: %s", filtered)
+	}
+}
+
+func TestNexusWebsocketCloseReasonRedaction(t *testing.T) {
+	matched, payload := websocketClosePayloadForUpstreamError(&websocket.CloseError{Code: websocket.CloseMessageTooBig, Text: "Anthropic https://host.test/path"})
+	if !matched || len(payload) < 2 || strings.Contains(string(payload[2:]), "Anthropic") || strings.Contains(string(payload[2:]), "https:") {
+		t.Fatalf("close reason leaked: %q", payload)
+	}
+}
