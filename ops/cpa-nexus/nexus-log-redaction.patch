+	for _, private := range []string{"Anthropic", "ChatGPT", "https://"} {
+		if strings.Contains(string(body), private) {
+			t.Fatalf("private string %q remained in Claude error: %s", private, body)
+		}
+	}
+	if response.Error.Type != "***AuthenticationError" || response.Error.Message != "*** rejected ***" {
+		t.Fatalf("unexpected public error: %s", body)
+	}
+	if msg.Error.Error() != original {
+		t.Fatal("output redaction modified the internal error")
+	}
+}
