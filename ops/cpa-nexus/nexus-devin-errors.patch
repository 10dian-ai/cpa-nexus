new file mode 100644
index 0000000000000000000000000000000000000000..6e69cdbc59324020ca1f6ed42a11e2b87a2dd59f
--- /dev/null
+++ b/internal/runtime/executor/helps/nexus_devin_errors_test.go
@@ -0,0 +1,35 @@
+package helps
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestNexusDevinInternalPermissionErrorIsTransient(t *testing.T) {
+	cases := []struct {
+		name, trailer string
+		want          int
+	}{
+		{"masked internal permission error", `{"error":{"code":"permission_denied","message":"an internal error occurred (trace ID: synthetic-trace)"}}`, http.StatusBadGateway},
+		{"case insensitive internal permission error", `{"error":{"code":"PERMISSION_DENIED","message":"An Internal Error Occurred (trace ID: synthetic-trace)"}}`, http.StatusBadGateway},
+		{"leading whitespace internal template", `{"error":{"code":"permission_denied","message":"  an internal error occurred (trace ID: synthetic-trace)"}}`, http.StatusBadGateway},
+		{"existing masked invalid argument error", `{"error":{"code":"invalid_argument","message":"an internal error occurred (trace ID: synthetic-trace)"}}`, http.StatusBadGateway},
+		{"actual permission denial", `{"error":{"code":"permission_denied","message":"model access is not allowed for this account"}}`, http.StatusForbidden},
+		{"permission message only mentions internal template", `{"error":{"code":"permission_denied","message":"model access is not allowed; a previous unrelated failure reported an internal error occurred"}}`, http.StatusForbidden},
+		{"other permission errors keep classification", `{"error":{"code":"permission_denied","message":"Unable to process request due to an MCP configuration issue."}}`, http.StatusForbidden},
+		{"high demand keeps classification", `{"error":{"code":"permission_denied","message":"The model is currently in high demand, please try again later"}}`, http.StatusTooManyRequests},
+		{"unrelated authentication error", `{"error":{"code":"unauthenticated","message":"invalid credentials"}}`, http.StatusUnauthorized},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			status, err := ParseDevinTrailerError([]byte(tc.trailer))
+			if status != tc.want || err == nil {
+				t.Fatalf("status/error = %d/%v, want %d/non-nil", status, err, tc.want)
+			}
+			if strings.Contains(tc.trailer, "synthetic-trace") && !strings.Contains(err.Error(), "synthetic-trace") {
+				t.Fatalf("upstream diagnostic was lost: %v", err)
+			}
+		})
+	}
+}
diff --git a/sdk/api/handlers/nexus_devin_errors_test.go b/sdk/api/handlers/nexus_devin_errors_test.go
