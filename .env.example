APP_URL=http://localhost:3000
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
POSTGRES_PASSWORD=replace-with-random-password
REDIS_PASSWORD=replace-with-random-password
DATABASE_URL=postgres://ccm:replace-with-random-password@127.0.0.1:55432/commandcode
REDIS_URL=redis://:replace-with-random-password@127.0.0.1:56379/0
# Remote account intake page (external service keys). Public by default.
INTAKE_PORT=3041
INTAKE_BIND_ADDRESS=0.0.0.0


# Ubuntu: bash scripts/deploy.sh up (Docker only; host Node.js is not needed).
# CPA settings are created separately in .env.cpa by setup.
# Existing .env and database credentials are kept intact.
# Compose: docker compose --env-file .env --env-file .env.cpa up -d --build
# CPA_URL=http://127.0.0.1:8317
# CPA_VERSION=v8.0.32
# CPA_IMAGE=cpa-nexus-core:v8.0.32-nexus1
# CPA_UPSTREAM_REF=911f49cbd49f4fe2516979754a7488a3fd14fe64
# CPA_UPSTREAM_IMAGE=eceasy/cli-proxy-api:v8.0.32@sha256:68f6e2d691f7b71aca21cfe87c77b7076cbea26c8ef490b15619b1623a7c0699
# Core policy uses the server-only APP_ENCRYPTION_KEY via Compose; never pass it to clients.
# CPA_MANAGEMENT_KEY=<generated server-only management key>
# CPA_CLIENT_KEY=<generated model API access key>
# Address the CPA kernel uses to reach module bridges inside the Compose network.
# NEXUS_BRIDGE_BASE_URL=http://app:3000

# 1Panel only: set its existing OpenResty Docker network, then use
# bash scripts/deploy.sh up --1panel (do not use a fixed container IP).
# PANEL_NETWORK=1panel-network

# logicc-gauth mini-kernel (Google OAuth renewal for Logicc accounts).
# Optional shared secret between the app/worker and the kernel; empty = open on the compose network.
# LOGICC_GAUTH_TOKEN=replace-with-random-token
