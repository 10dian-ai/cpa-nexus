ARG CPA_UPSTREAM_IMAGE=eceasy/cli-proxy-api:v8.0.32@sha256:68f6e2d691f7b71aca21cfe87c77b7076cbea26c8ef490b15619b1623a7c0699
FROM golang:1.26-bookworm AS kernel-build
ARG CPA_UPSTREAM_REF=911f49cbd49f4fe2516979754a7488a3fd14fe64
ARG CPA_UPSTREAM_VERSION=v8.0.32
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git init --quiet && git remote add origin https://github.com/router-for-me/CLIProxyAPI.git && git fetch --depth 1 origin "${CPA_UPSTREAM_REF}" && git checkout --detach FETCH_HEAD && test "$(git rev-parse HEAD)" = "${CPA_UPSTREAM_REF}"
COPY ops/cpa-nexus/nexus-plugins.patch /nexus-patches/0001-nexus-plugins.patch
COPY ops/cpa-nexus/nexus-log-redaction.patch /nexus-patches/0002-nexus-log-redaction.patch
COPY ops/cpa-nexus/nexus-devin-errors.patch /nexus-patches/0003-nexus-devin-errors.patch
RUN for change in /nexus-patches/*.patch; do git apply --check "$change" && git apply "$change"; done
RUN go mod download
RUN CGO_ENABLED=1 GOOS=linux go build -buildvcs=false -ldflags="-s -w -X main.Version=${CPA_UPSTREAM_VERSION} -X main.Commit=${CPA_UPSTREAM_REF}+nexus -X main.BuildDate=source-pinned" -o /CLIProxyAPI ./cmd/server/

# Keep the official runtime, shared-library loader, certificates and plugin layout.
FROM ${CPA_UPSTREAM_IMAGE} AS kernel-runtime
COPY --from=kernel-build /CLIProxyAPI /CLIProxyAPI/CLIProxyAPI
WORKDIR /CLIProxyAPI
CMD ["./CLIProxyAPI"]
